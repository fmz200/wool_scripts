#!name=联掌门户去广告
#!desc=移除开屏广告、弹窗，以及首页、服务和发现页的无用内容
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one

[General]
# HTTP 5090 端口也需要进入 HTTP 引擎才能匹配 Map Local。
force-http-engine-hosts = %APPEND% lzmh.lz-qs.com:5090


[Map Local]
(?i)^https://lzmh\.lz-qs\.com:6025/lzmh_app_api/api/v1/app3rd/getApp3rdGenreList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://lzmh\.lz-qs\.com:6025/lzmh_app_api/api/v1/ad/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yuudnn\.lz-qs\.com:9220/mssp-api/api/v1/mrtb/getAdSlotList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yuudnn\.lz-qs\.com:9220/mssp-api/api/v1/mrtb/requestAd$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yuudnn\.lz-qs\.com:9220/mssp-api/api/v1/mrtb/getSdkStartConfigList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://lzmh\.lz-qs\.com:6025/lzmh_app_api/api/v1/index/getRecommendList\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yuudnn\.lz-qs\.com/lzmh_app_api/o2o/api/v2/o2o/homeInfo$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yuudnn\.lz-qs\.com/lzmh_app_api/o2o/api/v2/o2o/homeShopList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https://yuudnn\.lz-qs\.com:9220/mssp-api/api/v1/mrtb/getSdkAdSlotList$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^http://lzmh\.lz-qs\.com:5090/resource/download/ data-type=text data="" status-code=404


[Body Rewrite]
http-response-jq (?i)^https://lzmh\.lz-qs\.com:6025/lzmh_app_api/api/v2/user/getUserBaseInfoAndConfig\? 'del(.value.config)'


[MITM]
hostname = %APPEND% lzmh.lz-qs.com:6025, yuudnn.lz-qs.com:9220, yuudnn.lz-qs.com

