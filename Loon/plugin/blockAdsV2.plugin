request if ${url} ~= /^https?:\/\/api\.u51\.com\/(generic-config-gateway|rs-resys)\/api\/v\d\/(creditpage-config|recommend)/ then reject(200)

# > 555影视
# hostname = vip7.fzwdyy.cn, *.qyfxgd.cn, *.weilai555.com, *.ecoliving168.com
request if ${url} ~= /^https?:\/\/vip7\.fzwdyy\.cn:8083\/api\/(getAdvertInfo|getGOOGAdvert)/ then reject(200)
request if ${url} ~= /^https?:\/\/[a-zA-Z0-9-]+(\.[a-zA-Z0-9-]+){1,3}(:\d+)?\/api\/v\d\/advert/ then reject(404)

# > 58同城
# hostname = *.58cdn.com.cn, app.58.com
request if ${url} ~= /^https?:\/\/.+?\.58cdn\.com\.cn\/brandads\// then reject(200)
request if ${url} ~= /^https?:\/\/app\.58\.com\/api\/home\/(advertising|appadv)\// then reject(404)
