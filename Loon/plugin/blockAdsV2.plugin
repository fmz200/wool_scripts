[Rewrite]
# >>>>>>>>>>>>>>> ✅ 0 ✅ <<<<<<<<<<<<<<


# >>>>>>>>>>>>>>> ✅ 1 ✅ <<<<<<<<<<<<<<

# > 12123
# hostname = gab.122.gov.cn
#^https?:\/\/gab\.122\.gov\.cn\/eapp\/m\/sysquery reject
request if ${url} ~= /^https?:\/\/gab\.122\.gov\.cn\/eapp\/m\/sysquery\/adver$/ then reject(404)


# >>>>>>>>>>>>>>> ✅ 2 ✅ <<<<<<<<<<<<<<

# > 21经济网
# hostname = api.21jingji.com
request if ${url} ~= /^https?:\/\/api\.21jingji\.com\/ad\// then reject(404)

# > 2345天气王
# hostname = tianqi.2345.com
# 底下百家号广告 感谢【 🐈‍⬛👮】分享
request if ${url} ~= /^http?:\/\/tianqi\.2345\.com\/api\/content\/getContentFeeds\.php/ then reject_dict(200)


# >>>>>>>>>>>>>>> ✅ 3 ✅ <<<<<<<<<<<<<<

# > 360儿童卫士
# hostname = ad.life.360.cn
# 开屏广告 感谢【别怕我又不乱来】分享
request if ${url} ~= /^https?:\/\/ad\.life\.360\.cn\/v2\/app\/advertisement\/config\?sdk_ver=/ then reject_dict(200)

# > 36kr
# hostname = gateway.36kr.com
# ^https?:\/\/gateway\.36kr\.com\/api\/adx\/ad\/show reject


