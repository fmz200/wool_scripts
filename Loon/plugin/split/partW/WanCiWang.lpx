#############################################


[Rewrite]
# 感谢【sliverkiss】分享
# 移除开屏
request if ${url} ~= /^https?:\/\/wanciwangdata\.oss-cn-beijing\.aliyuncs\.com\/startup\/resource\/content.+/i then reject(404)
# 移除banner广告
request if ${url} ~= /^https?:\/\/recite\.perfectlingo\.com\/api\/recite\/app-act\/act-list.+/i then reject_dict(200)
# 移除底部广告
request if ${url} ~= /^https?:\/\/recite\.perfectlingo\.com\/api\/recite\/content-recommend\/v\d\/get-by-uid.+/i then reject_dict(200)
# 移除悬浮广告
request if ${url} ~= /^https?:\/\/recite\.perfectlingo\.com\/api\/recite\/floating-window\/v\d\/get-show.+/i then reject_dict(200)


[MITM]
hostname = wanciwangdata.oss-cn-beijing.aliyuncs.com, recite.perfectlingo.com
