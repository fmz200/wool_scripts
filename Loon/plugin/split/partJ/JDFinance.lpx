[Rewrite]
request if ${url} ~= /^https?:\/\/m.360buyimg\.com\/mobilecms\/s1125x2436_jfs\//i then reject(200)
request if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start/i then reject_img(200)
request if ${url} ~= /^https?:\/\/(bdsp-x|dsp-x)\.jd\.com\/adx\//i then reject(200)
request if ${url} ~= /^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/aladdin\/(new)?na\/m\/getLoadingPicture/i then reject(404)
request if ${url} ~= /^https?:\/\/appconf\.mail\.163\.com\/mmad\//i then reject(404)
request if ${url} ~= /^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia\.json/i then reject(404)


[MITM]
hostname = m.360buyimg.com, api.m.jd.com, bdsp-x.jd.com, dsp-x.jd.com, ms.jr.jd.com, appconf.mail.163.com, support.you.163.com
