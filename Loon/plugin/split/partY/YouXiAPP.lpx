#!name=悠洗APP
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/gif/naisi-01.gif
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Loon/plugin/split/partY/YouXiAPP.lpx
#!tg-channel=https://t.me/inaisi
#!date=2026-11-11 21:17:23
#############################################


[Argument]
yzxiapp_enable = switch,true,false,tag=悠洗APP-脚本开关

[Rewrite]
# 净化 感谢【TEXAS】分享
request if ${url} ~= /^https?:\/\/api\.ulife\.group\/signintask\/adServing/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.ulife\.group\/auth\/account\/getUpgradeStrategy/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/frontEntrance\/getThirdAdvertising\?displayPort=1&type=15/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/memberCard\/listMemberCard\?isShowSecondaryCard=1/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.ulife\.group\/auth\/account\/entrance/i then reject_dict(200)


[Script]
response if ${url} ~= /^https?:\/\/api\.ulife\.group\/market\/homeIconDetail\/list\/v7/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/yx.js") with enable=${yzxiapp_enable}, tag="悠洗APP", timeout=60, requires_body=true




[MITM]
hostname = api.ulife.group
