[Rewrite]
request if ${url} ~= /^https?:\/\/api\.yikaobang\.com\.cn\/client\/main\/homePageSmallAd/i then reject(404)
request if ${url} ~= /^https?:\/\/api\.yikaobang\.com\.cn\/index\.php\/Client\/main\/startPage/i then reject(404)
# 去强制更新 感谢【SH DDDDD】分享
request if ${url} ~= /^https?:\/\/api\.yikaobang\.com\.cn\/index\.php\/version\/version\/check/i then reject(404)


[MITM]
hostname = api.yikaobang.com.cn
