#############################################


[Argument]
kxke_enable = switch,true,false,tag=夸克-脚本开关

[Script]
response if ${url} ~= /^https?:\/\/open-cms-api\.(uc|quark)\.cn\/open-cms/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/quark.js") with enable=${kxke_enable}, tag="夸克", timeout=60, requires_body=true

[MITM]
hostname = open-cms-api.uc.cn, open-cms-api.quark.cn
