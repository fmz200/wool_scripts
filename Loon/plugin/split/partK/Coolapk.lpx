#!name=酷安
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/gif/naisi-01.gif
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Loon/plugin/split/partK/Coolapk.lpx
#!tg-channel=https://t.me/inaisi
#!date=2026-11-11 21:17:23
#############################################


[Argument]
kuan_enable = switch,true,false,tag=酷安-脚本开关

[Rule]
# 广告联盟已包含, REJECT




[Rewrite]
# ^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch reject-dict


[Script]
response if ${url} ~= /^https?:\/\/api\.coolapk\.com\/v6\/feed\/(detail|replyList)\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js") with enable=${kuan_enable}, tag="酷安", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/api\.coolapk\.com\/v6\/main\/(dataList|indexV8|init)/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js") with enable=${kuan_enable}, tag="酷安", timeout=60, requires_body=true
response if ${url} ~= /^https?:\/\/api\.coolapk\.com\/v6\/page\/dataList\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/coolapk.js") with enable=${kuan_enable}, tag="酷安", timeout=60, requires_body=true
request if ${url} ~= /^https:\/\/www\.coolapk\.com\/link.*/i then script("https://raw.githubusercontent.com/VenenoSix24/Ivy-Script/refs/heads/main/Loon/script/Coolapk_Redirect.js") with enable=${kuan_enable}, tag="酷安URL重定向", timeout=10



[MITM]
hostname = api.coolapk.com, www.coolapk.com
