[Rewrite]
request if ${url} ~= /^https?:\/\/qde\.qunar\.com\/preload/i then reject(200)
# 开屏广告
request if ${url} ~= /^https?:\/\/homefront\.qunar\.com\/front\/splash\/ad/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/client\.qunar\.com\/pitcher-proxy\?qrt=p_splashAd/i then reject(404)


[MITM]
hostname = qde.qunar.com, homefront.qunar.com, client.qunar.com
