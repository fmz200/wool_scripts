#############################################


[Rule]
DOMAIN-SUFFIX, prom.gome.com.cn, REJECT


[Rewrite]
request if ${url} ~= /^https?:\/\/prom\.mobile\.gome\.com\.cn\/mobile\/promotion\/promscms\/\w+\.jsp/i then reject(404)
request if ${url} ~= /^https?:\/\/prom\.mobile\.gome\.com\.cn\/mobile\/promotion\/promscms\/sale\w+\.jsp/i then reject(404)


[MITM]
hostname = prom.mobile.gome.com.cn
