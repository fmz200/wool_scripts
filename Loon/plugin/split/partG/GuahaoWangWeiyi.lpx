[Rewrite]
request if ${url} ~= /^https?:\/\/kano\.guahao\.cn\/[a-zA-Z0-9]{12}/i then reject(200)
request if ${url} ~= /^https?:\/\/kano\.guahao\.cn\/.+?\?resize=\d{3}-\d{4}/i then reject_img(200)
request if ${url} ~= /^https?:\/\/app\.wy\.guahao\.com\/json\/white\/dayquestion\/getpopad/i then reject(404)


[MITM]
hostname = kano.guahao.cn, app.wy.guahao.com
