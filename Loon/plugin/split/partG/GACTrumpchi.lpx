[Rewrite]
# 开屏广告 感谢【Charlie】分享
request if ${url} ~= /^https?:\/\/gsp\.gacmotor\.com\/gateway\/webapi\/baseinfo\/advertise\/getAdvertiseByPositionCode\?positionCode=1/i then reject_dict(200)
# 更新弹窗  感谢【企鹅】分享
request if ${url} ~= /^https?:\/\/gsp\.gacmotor\.com\/gateway\/app-api\/app\/version\/latestupdate\?flatform=2&innerVersion=/i then reject_dict(200)


[MITM]
hostname = gsp.gacmotor.com
