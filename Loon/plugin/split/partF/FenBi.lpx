#!date=2026-11-11 21:17:23
#############################################


[Argument]
ffbi_enable = switch,true,false,tag=粉笔-脚本开关

[Script]
response if ${url} ~= /^https?:\/\/tiku\.fenbi\.com\/activity\/app\/launcher\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/fenbi.js") with enable=${ffbi_enable}, tag="粉笔开屏广告", timeout=60, requires_body=true

[MITM]
hostname = tiku.fenbi.com
