[Rewrite]
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.fliggy\.crm\.screen\.(allresource|predict)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.trip\.activity\.querytmsresources\/1\.0\?type=originaljson/i then reject_img(200)
request if ${url} ~= /^https?:\/\/gw\.alicdn\.com\/mt\//i then reject(404)
request if ${url} ~= /^https?:\/\/gw\.alicdn\.com\/imgextra\/\w{2}\/[\w!]+-\d-tps-\d{3}-\d{4}\.(jpg|png)$/i then reject(404)


[MITM]
hostname = acs.m.taobao.com, gw.alicdn.com
