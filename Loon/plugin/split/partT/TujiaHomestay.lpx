#############################################


[Rewrite]
# 需要卸载重装
request if ${url} ~= /^https?:\/\/client\.tujia\.com\/bnbapp-node/i then reject_dict(200)
response if ${url} ~= /^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/portal\/getportalconfig\/bnb\/v2/i then response.body.replace(/"banners":\[.+\],/, "\"banners\":[],")
request if ${url} ~= /^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/(promotion\/popup\/getpopupups\/bnb|portal\/getStartPictureAdvertising)/i then reject(404)


[MITM]
hostname = client.tujia.com
