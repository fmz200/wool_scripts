[Rewrite]
request if ${url} ~= /^https?:\/\/gw-passenger\.01zhuanche\.com\/gw-passenger\/car-rest\/webservice\/passenger\/recommendADs/i then reject(200)
request if ${url} ~= /^https?:\/\/gw-passenger\.01zhuanche\.com\/gw-passenger\/zhuanche-passenger-token\/leachtoken\/webservice\/homepage\/queryADs/i then reject(404)
request if ${url} ~= /^https?:\/\/gw-passenger\.01zhuanche\.com\/gw-passenger\/zhuanche-passengerController\/notk\/passenger\/recommendADs/i then reject(404)
request if ${url} ~= /^https?:\/\/img\.yun\.01zhuanche\.com\/statics\/app\/advertisement\/.+?-750-1334/i then reject_img(200)


[MITM]
hostname = gw-passenger.01zhuanche.com, img.yun.01zhuanche
