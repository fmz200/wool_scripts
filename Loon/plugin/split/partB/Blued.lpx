#!name=Blued
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/gif/naisi-01.gif
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Loon/plugin/split/partB/Blued.lpx
#!tg-channel=https://t.me/inaisi
#!date=2026-11-11 21:17:23
#############################################


[Argument]
blued_enable = switch,true,false,tag=Blued-脚本开关

[Rewrite]
# 主页推荐直播 
request if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/recommend/i then reject_dict(200)
# 未登录时个人界面广告
request if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/no_auth\/benefit/i then reject_dict(200)


[Script]
# 登录后个人界面广告
response if ${url} ~= /^https?:\/\/social\.blued\.cn\/users\/.+\/more\/ios\?v=2/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/blued.js") with enable=${blued_enable}, tag="blued登录后个人界面广告", timeout=60, requires_body=true


[MITM]
hostname = social.blued.cn
