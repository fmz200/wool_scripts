[Rewrite]
request if ${url} ~= /^https?:\/\/supportda\.ofo\.com\/adaction\?/i then reject(404)
request if ${url} ~= /^https?:\/\/ma\.ofo\.com\/adImage\//i then reject(404)
request if ${url} ~= /^https?:\/\/ma\.ofo\.com\/ads/i then reject(404)
request if ${url} ~= /^https?:\/\/activity2\.api\.ofo\.com\/ofo\/Api\/v2\/ads/i then reject(404)


[MITM]
hostname = supportda.ofo.com, ma.ofo.com, activity2.api.ofo.com
