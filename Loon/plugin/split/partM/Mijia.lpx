[Rule]
DOMAIN, sdkconfig.ad.xiaomi.com, REJECT


[Rewrite]
request if ${url} ~= /^https?:\/\/home\.mi\.com\/cgi-op\/api\/v1\/recommendation\/(banner|carousel\/banners|myTab|openingBanner)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/home\.mi\.com\/cgi-op\/api\/v1\/resource\/realtime\/openingBanner/i then reject_dict(200)


[MITM]
hostname = home.mi.com
