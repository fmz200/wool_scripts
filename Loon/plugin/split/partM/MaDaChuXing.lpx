#############################################


[Rewrite]
# 开屏广告
request if ${url} ~= /^https:\/\/mada-travel\.17u\.cn\/mdapi\/config\/ads/i then reject_dict(200)
# 我的会员中心
request if ${url} ~= /^https:\/\/mada-travel\.17u\.cn\/mdapi\/config\/mine/i then reject_dict(200)
# 首页下方推广
request if ${url} ~= /^https:\/\/mada-travel\.17u\.cn\/mdapi\/config\/tabAct/i then reject_dict(200)
# 屏蔽更新
request if ${url} ~= /^http:\/\/ebk\.17u\.cn\/tctrafficappversionadmin\/api\/getLatestVersionApp/i then reject_dict(200)


[MITM]
hostname = mada-travel.17u.cn, ebk.17u.cn
