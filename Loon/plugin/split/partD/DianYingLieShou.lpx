[Argument]
dyls_enable = switch,true,false,tag=电影猎手-脚本开关

[Script]
response if ${url} ~= /^https:\/\/app-v1\.ecoliving168\.com\/api\/v1\/movie\/index_recommend\?/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/dianyinglieshou.js") with enable=${dyls_enable}, tag="电影猎手去广告", timeout=60, requires_body=true


[MITM]
hostname = app-v1.ecoliving168.com
