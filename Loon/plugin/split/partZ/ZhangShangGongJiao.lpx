#!date=2026-11-11 21:17:23
#############################################


[Argument]
vhuhgsjn_enable = switch,true,false,tag=掌上公交-脚本开关

[Rewrite]
# 我的横幅广告
request if ${url} ~= /^https?:\/\/quanguo\.mygolbs\.com:8081\/MyBusServer\/servlet\/MyGoServer\.HttpPool\.HttpHandlerServlet/i then reject(200)


[Script]
response if ${url} ~= /^https?:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/zhangshanggongjiao.js") with enable=${vhuhgsjn_enable}, tag="掌上公交小程序广告", timeout=60, requires_body=true


[MITM]
hostname = quanguo.mygolbs.com, wx.mygolbs.com
