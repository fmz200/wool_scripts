[Rewrite]
# https://rarbgmirror.org/torrents.php
request if ${url} ~= /^https?:\/\/dyncdn\.me\/static\/\d{0,2}\/js\/expla\d{0,4}\.js$/i then reject(200)
response if ${url} ~= /^https?:\/\/dyncdn\.me\/static\/\d{0,2}\/js\/showads\.js$/i then response.body.replace(/true/, "false")


[MITM]
hostname = dyncdn.me
