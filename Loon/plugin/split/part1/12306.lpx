[Argument]
12306_enable = switch,true,false,tag=12306-脚本开关

[Script]
request if ${url} ~= /^https?:\/\/ad\.12306\.cn\/ad\/ser\/getAdList/i then script("https://raw.githubusercontent.com/kokoryh/Script/master/js/12306.js") with enable=${12306_enable}, tag="12306", timeout=60, requires_body=true




[MITM]
hostname = ad.12306.cn
