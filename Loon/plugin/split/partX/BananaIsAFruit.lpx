#############################################


[Argument]
xljnuiyivsuvgo_enable = switch,true,false,tag=香蕉是一种水果-脚本开关

[Script]
response if ${url} ~= /^https?:\/\/.+?\.(pipi|fuli|xiang(jiao|xiang))apps\.com\/(ucp\/index|getGlobalData|(\/|)vod\/reqplay\/)/i then script("https://raw.githubusercontent.com/NobyDa/Script/master/QuantumultX/File/xjsp.js") with enable=${xljnuiyivsuvgo_enable}, tag="香蕉是一种水果", timeout=60, requires_body=true

[MITM]
hostname = *.pipiapps.com, *.fuliapps.com, *.xiangjiaoapps.com, *.xiangxiangapps.com
