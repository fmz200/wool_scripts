[Rewrite]
# ^https?:\/\/client-api-v2\.oray\.com\/materials reject-200
# 开屏广告
request if ${url} ~= /^https?:\/\/client-api-v2\.oray\.com\/materials\/SLCC_IOS_STARTUP/i then reject_dict(200)
# 首页文字广告
request if ${url} ~= /^https?:\/\/client-api-v2\.oray\.com\/materials\/SLCC_IOS_DEVICE/i then reject_dict(200)
# 发现页广告
request if ${url} ~= /^https?:\/\/client-api-v2\.oray\.com\/materials\/SUNLOGIN_CLIENT_IOS_PROMOTION/i then reject_dict(200)


[MITM]
hostname = client-api-v2.oray.com
