[Rewrite]
# 去除更新弹窗
request if ${url} ~= /^https:\/\/spamblocker-api\.zeekstudio\.com\/profile/i then reject_dict(200)
request if ${url} ~= /^https:\/\/spamblocker-api\.zeekstudio\.com\/checkVersion/i then reject_dict(200)


[MITM]
hostname = spamblocker-api.zeekstudio.com
