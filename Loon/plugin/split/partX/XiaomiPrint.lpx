[Rewrite]
# 去开屏 感谢【别怕我又不乱来】分享
request if ${url} ~= /^https?:\/\/api-miprint\.hannto\.com\/v1\/c\/res\/app\/ad\/\?app_version/i then reject_dict(200)
# 主页上方广告
request if ${url} ~= /^https?:\/\/api\.indeedpower\.com\/v1\/m\/edu\/module\/homepage_banner\/\?randomStr/i then reject_dict(200)


[MITM]
hostname = api-miprint.hannto.com, api.indeedpower.com
