#!arguments=yzxiapp_enable:true
#!arguments-desc=yzxiapp_enable: yzxiapp_enable

[Map Local]
# 净化 感谢【TEXAS】分享
^https?:\/\/api\.ulife\.group\/signintask\/adServing data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/api\.ulife\.group\/auth\/account\/getUpgradeStrategy data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/api\.ulife\.group\/market\/frontEntrance\/getThirdAdvertising\?displayPort=1&type=15 data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/api\.ulife\.group\/market\/memberCard\/listMemberCard\?isShowSecondaryCard=1 data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/api\.ulife\.group\/auth\/account\/entrance data-type=text data="{}" header="Content-Type:application/json"

[Script]
悠洗APP = type=http-response, pattern=^https?:\/\/api\.ulife\.group\/market\/homeIconDetail\/list\/v7, script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/yx.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.ulife.group
