#!name=游民星空
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!category=奶思的模块
#!homepage=https://github.com/fmz200/wool_scripts
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/Shadowrocket/module/split/partY/Gamersky.srmodule
#!tg-channel=https://t.me/inaisi
#!date=2026-11-11 21:17:23
#############################################


[Rule]
DOMAIN-SUFFIX,ja.gamersky.com,REJECT
DOMAIN-SUFFIX,ja1.gamersky.com,REJECT

[Body Rewrite]
http-response-jq http:\/\/.+\.gamersky.com/.+/lists/getListElements '.listElements |= map(select(has("adCategory") | not))'

[Map Local]
# 移除开屏广告、列表广告
^http:\/\/.+\.gamersky\.com\/.+\/adSystem\/ad\/.+ data-type=text data="{}" header="Content-Type:application/json"

https://.+\.gamersky.com/v1/statisticAd data-type=text data="{}" header="Content-Type:application/json"

[MITM]
hostname = %APPEND% *.gamersky.com
