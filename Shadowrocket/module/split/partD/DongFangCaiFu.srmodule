[Rule]
DOMAIN-SUFFIX,bduserlog.eastmoney.com,REJECT
DOMAIN-SUFFIX,js4.eastmoney.com,REJECT
DOMAIN-SUFFIX,same.eastmoney.com,REJECT

[URL Rewrite]
^https?:\/\/emdcadvertise\.eastmoney\.com\/infoService\/v\d - reject

[Map Local]
# 东方航空
^https?:\/\/app\.ceair\.com\/customize\/security\/update data-type=text data=" "

^https?:\/\/app\.ceair\.com\/customize\/main\/adScreen data-type=text data="{}" header="Content-Type:application/json"

[MITM]
hostname = %APPEND% app.ceair.com
