[Map Local]
# 微信小程序净化
^https?:\/\/hdgateway\.zto\.com\/getApolloConfig data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/hdgateway\.zto\.com\/track data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/hdgateway\.zto\.com\/getAdInfo data-type=text data="{}" header="Content-Type:application/json"

^https?:\/\/hdgateway\.zto\.com\/listJumperShow data-type=text data="{}" header="Content-Type:application/json"

[MITM]
hostname = %APPEND% hdgateway.zto.com
