http:

  mitm:
    - "*.mgtv.com"

  url-rewrite:
    - >-
      ^https?:\/\/[\d\.]+:\d{5}\/\?(?:[^#?&]+&)*cmd=indexes - reject
    - >-
      ^https?:\/\/[\d\.]+\/odin\/c1\/(channel\/ads|skin\/config)\? - reject-dict
    - >-
      ^https?:\/\/damang\.api\.mgtv\.com\/station\/album\/red\/dot\? - reject-dict
    - >-
      ^https?:\/\/hb-boom\.api\.mgtv\.com\/release\/pullReleaseInfo - reject-dict
    - >-
      ^https?:\/\/mobile\.api\.mgtv\.com\/v2\/mobile\/checkUpdate\? - reject-dict
    - >-
      ^https?:\/\/mobileso\.bz\.mgtv\.com\/spotlight\/search\/v1\? - reject-dict

  script:
    - match: ^https?:\/\/me\.bz\.mgtv\.com\/v3\/module\/list\?
      name: "芒果TV我的页面_56"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/mob-st\.bz\.mgtv\.com\/odin\/c1\/channel\/index\?
      name: "芒果TV我的页面_56"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/dc2?\.bz\.mgtv\.com\/dynamic\/v1\/channel\/(index|vrsList)\/\w
      name: "芒果TV我的页面_56"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/mobile\.api\.mgtv\.com\/mobile\/config\?
      name: "芒果TV我的页面_56"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/mobile\.api\.mgtv\.com\/v10\/video\/info\?
      name: "芒果TV我的页面_56"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/mobile-thor\.api\.mgtv\.com\/v1\/vod\/info\?
      name: "芒果TV我的页面_56"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/mobileso\.bz\.mgtv\.com\/mobile\/recommend\/v2\?
      name: "芒果TV我的页面_56"
      type: response
      require-body: true
      timeout: 60

script-providers:
  "芒果TV我的页面_56":
    url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cnftp.js
    interval: 86400

