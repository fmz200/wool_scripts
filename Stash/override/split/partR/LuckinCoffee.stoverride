name: |-
  瑞幸咖啡
desc: |-
  某些APP要清除缓存或者重新安装拦截广告才会生效！
author: |-
  奶思
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1035.png
category: |-
  奶思的模块
homepage: |-
  https://github.com/fmz200/wool_scripts
raw-url: |-
  https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partR/LuckinCoffee.sgmodule
tg-channel: |-
  https://t.me/inaisi
date: |-
  2026-11-11 21:17:23

http:

  mitm:
    - "capi.lkcoffee.com"
    - "ecapi.lkcoffee.com"
    - "m.lkcoffee.com"
    - "img0*.luckincoffeecdn.com"

  url-rewrite:
    - >-
      ^https?:\/\/img0[1-9]{1}\.luckincoffeecdn\.com\/group\d/M00/[A-Z0-9]{2}/[A-Z0-9]{2}/[a-zA-Z0-9]{29}\.(jpg|jpeg)_\.webp - reject-200

  body-rewrite:
    - >-
      ^https?:\/\/capi\.lkcoffee\.com\/resource\/m\/sys\/app\/adposNew response-replace-regex \{.+\} {"status":"SUCCESS"}
    - >-
      ^https?:\/\/m\.lkcoffee\.com\/ecapi\/resource\/m\/member\/exchange\/page response-replace-regex \{.+\} {"status":"SUCCESS"}
    - >-
      ^https?:\/\/m\.lkcoffee\.com\/capi\/resource\/m\/growUp\/main response-replace-regex popTitle":".+?" "popTitle":"

  script:
    - match: ^https?:\/\/(ec|c)api\.lkcoffee\.com\/resource\/m\/eorder\/product\/popAppTagProductList
      name: "echoResponse_15"
      type: request
      timeout: 60
      argument: |-
        text=%7B%22status%22%3A%22SUCCESS%22%7D

script-providers:
  "echoResponse_15":
    url: https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/echo-response.js
    interval: 86400

