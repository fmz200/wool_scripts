    - match: ^https:\/\/j1\.pupuapi\.com\/client\/app_resource\/resource_preload\/list_h5_resource
      name: "朴朴超市_32"
      type: response
      require-body: true
      timeout: 60

    - match: ^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1
      name: "朴朴超市_32"
      type: response
      require-body: true
      timeout: 60

    - match: ^https:\/\/j1\.pupuapi\.com\/client\/search\/hub\/search_box\/products\/v6
      name: "朴朴超市_32"
      type: response
      require-body: true
      timeout: 60

    - match: ^https:\/\/j1\.pupuapi\.com\/client\/order_settlement\/detail
      name: "朴朴超市_32"
      type: response
      require-body: true
