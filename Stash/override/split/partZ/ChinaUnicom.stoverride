rules:
  - DOMAIN-SUFFIX,m1.ad.10010.com,REJECT

http:

  mitm:
    - "m.client.10010.com"
    - "m1.ad.10010.com"
    - "res.mall.10010.cn"

  url-rewrite:
    - >-
      ^https?:\/\/m\.client\.10010\.com\/mobileService\/(activity|customer)\/(accountListData|get_client_adv|get_startadv) - reject-200
    - >-
      ^https?:\/\/m\.client\.10010\.com\/mobileService\/customer\/getclientconfig\.htm - reject-dict
    - >-
      ^https?:\/\/m\.client\.10010\.com\/uniAdmsInterface\/(getHomePageAd|getWelcomeAd) - reject-200
    - >-
      ^https?:\/\/[^(apple|10010)]+\.(com|cn)\/(a|A)d(s|v)?(\/|\.js) - reject-200
    - >-
      ^https?:\/\/m1\.ad\.10010\.com\/noticeMag\/images\/imageUpload\/2\d{3} - reject-200
    - >-
      ^https?:\/\/res\.mall\.10010\.cn\/mall\/common\/js\/fa\.js?referer= - reject-200

