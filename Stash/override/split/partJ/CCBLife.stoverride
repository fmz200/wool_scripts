name: |-
  建行生活
desc: |-
  某些APP要清除缓存或者重新安装拦截广告才会生效！
author: |-
  奶思
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1019.png
category: |-
  奶思的模块
homepage: |-
  https://github.com/fmz200/wool_scripts
raw-url: |-
  https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partJ/CCBLife.sgmodule
tg-channel: |-
  https://t.me/inaisi
date: |-
  2026-11-11 21:17:23

rules:
  - DOMAIN,o2o-ad-log-gateway.alibaba.com,REJECT

http:

  mitm:
    - "yunbusiness.ccb.com"
    - "g.alicdn.com"
    - "waimai-guide.ele.me"

  url-rewrite:
    - >-
      ^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.wamai\.store\.detail\.miniapp\.popup - reject
    - >-
      ^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopcouponpopupservice\.getshopcouponspopup - reject
    - >-
      ^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?(?:[^#?&]+&)*txcode=A3341A(002|006|009|119|120) - reject-200
    - >-
      ^https?:\/\/yunbusiness\.ccb\.com\/clp_service\/txCtrl\?(?:[^#?&]+&)*txcode=A3341C147 - reject-200
    - >-
      ^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.alsc\.eleme\.\w+\.trigger\.respond - reject-dict

  body-rewrite:
    - >-
      ^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\? response-replace-regex TAG_AD_INFO" "fmz200
    - >-
      ^https?:\/\/waimai-guide\.ele\.me\/\w+\/mtop\.venus\.shopresourceservice\.getshopresource response-replace-regex posterList fmz200

  script:
    - match: ^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB05
      name: "A3341AB05_25"
      type: request
      binary-mode: true
      timeout: 60

    - match: ^https?:\/\/yunbusiness\.ccb\.com\/basic_service\/txCtrl\?txcode=A3341AB04
      name: "建行生活_27"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/g\.alicdn\.com\/.*o2o-ad
      name: "建行生活内置饿了么_29"
      type: response
      require-body: true
      timeout: 60

script-providers:
  "A3341AB05_25":
    url: http://script.hub/convert/_start_/https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/ccbLife/A3341AB05.json/_end_/A3341AB05.json?type=mock&target-app=stash-stoverride&headers=
    interval: 86400
  "建行生活_27":
    url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/ccbLife/ccbLifeAds.js
    interval: 86400
  "建行生活内置饿了么_29":
    url: https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/alicdn.js
    interval: 86400

