name: |-
  哔哩哔哩漫画
desc: |-
  某些APP要清除缓存或者重新安装拦截广告才会生效！
author: |-
  奶思
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1070.png
category: |-
  奶思的模块
homepage: |-
  https://github.com/fmz200/wool_scripts
raw-url: |-
  https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partB/BilibiliComics.sgmodule
tg-channel: |-
  https://t.me/inaisi
date: |-
  2026-11-11 21:17:23

http:

  mitm:
    - "manga.bilibili.com"
    - "i*.hdslb.com"

  url-rewrite:
    - >-
      ^https?:\/\/i\d\.hdslb\.com\/bfs\/fawkes - reject-dict
    - >-
      ^https?:\/\/i\d\.hdslb\.com\/bfs\/manga-static\/\w+\.(?>jpg|png)$ - reject-200
    - >-
      ^https?:\/\/i\d\.hdslb\.com\/bfs\/manga-static\/\w+\.(?>jpg|png)@1200w_1500h_1e_1c - reject-200
    - >-
      ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(?>Recommend|MoreRecommend|Flash|ListFlash|GetBubbles|GetActivityTab|GetCommonBanner|GetComicConfigPicList|SearchBanner|AppInit) - reject-200
    - >-
      ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Shop\/GetShopItems - reject-dict
    - >-
      ^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.SeasonV\d\/GetSeasonInfo - reject-dict
    - >-
      ^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.Read\/ActInfo - reject-200
    - >-
      ^https?:\/\/manga\.bilibili\.com\/twirp\/novel\.v\d\.Novel\/MoreRecommend - reject-dict

  script:
    - match: ^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/UCenterConf
      name: "哔哩哔哩漫画_20"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/manga\.bilibili\.com\/twirp\/user\.v\d\.User\/GetInitInfo
      name: "哔哩哔哩漫画_20"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Home\/HomeFeed
      name: "哔哩哔哩漫画_20"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comment\/Main
      name: "哔哩哔哩漫画_20"
      type: response
      require-body: true
      timeout: 60

script-providers:
  "哔哩哔哩漫画_20":
    url: https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliManga.js
    interval: 86400

