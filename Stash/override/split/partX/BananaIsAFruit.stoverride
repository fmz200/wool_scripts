http:

  mitm:
    - "*.pipiapps.com"
    - "*.fuliapps.com"
    - "*.xiangjiaoapps.com"
    - "*.xiangxiangapps.com"

  script:
    - match: ^https?:\/\/.+?\.(pipi|fuli|xiang(jiao|xiang))apps\.com\/(ucp\/index|getGlobalData|(\/|)vod\/reqplay\/)
      name: "香蕉是一种水果_11"
      type: response
      require-body: true
      timeout: 60

script-providers:
