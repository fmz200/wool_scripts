  https://t.me/inaisi
date: |-
  2026-11-11 21:17:23

http:

  mitm:
    - "app02.vgtime.com"

  script:
    - match: ^https?:\/\/app02\.vgtime\.com:8080\/vgtime-app\/api\/v2\/init\/ad\.json
      name: "vgTime_12"
      type: response
      require-body: true
      timeout: 60

script-providers:
  "vgTime_12":
    url: https://raw.githubusercontent.com/app2smile/rules/master/js/vgtime.js
    interval: 86400

