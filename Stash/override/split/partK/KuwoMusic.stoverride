name: |-
  酷我音乐
desc: |-
  某些APP要清除缓存或者重新安装拦截广告才会生效！
author: |-
  奶思
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1026.png
category: |-
  奶思的模块
homepage: |-
  https://github.com/fmz200/wool_scripts
raw-url: |-
  https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partK/KuwoMusic.sgmodule
tg-channel: |-
  https://t.me/inaisi
date: |-
  2026-11-11 21:17:23

rules:
  - DOMAIN,mobilead.kuwo.cn,REJECT
  - DOMAIN,rich.kuwo.cn,REJECT
  - DOMAIN-KEYWORD,rich.kuwo.cn,REJECT
  - DOMAIN-KEYWORD,mobilead.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,c.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,deliver.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,game.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,kuwoyy.com,REJECT
  - DOMAIN-SUFFIX,kwmsg.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,msclick2.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,msphoneclick.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,updatepage.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,wa.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,webstat.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,mobilead.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,rich.kuwo.cn,REJECT
  - DOMAIN-SUFFIX,ad.kuwo.cn,REJECT

http:

  mitm:
    - "audiobookpay.kuwo.cn"
    - "mgxhtj.kuwo.cn"
    - "nmobi.kuwo.cn"
    - "searchrecterm.kuwo.cn"
    - "musicpay.kuwo.cn"
    - "vip1.kuwo.cn"

  url-rewrite:
    - >-
      ^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p\?(?:[^#?&]+&)*op=get_advertright_endtime - reject-dict

  script:
    - match: ^https?:\/\/(mgxhtj|nmobi|searchrecterm)\.kuwo\.cn\/(mgxh|mobi|recterm)\.s
      name: "酷我音乐_32"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/audiobookpay\.kuwo\.cn\/a\.p
      name: "酷我音乐_32"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/musicpay\.kuwo\.cn\/music\.pay
      name: "酷我音乐_32"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/vip1\.kuwo\.cn\/vip\/(enc\/user\/vip\?op=ui|v\d\/theme\?op=gd)
      name: "酷我音乐_32"
      type: response
      require-body: true
      timeout: 60

    - match: ^https?:\/\/vip1\.kuwo\.cn\/vip\/v\d\/user\/vip\?op=ui
      name: "酷我音乐_32"
      type: response
      require-body: true
      timeout: 60

script-providers:
  "酷我音乐_32":
    url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/kuwo/kuwo.js
    interval: 86400

