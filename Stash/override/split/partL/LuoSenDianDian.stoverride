http:

  mitm:
    - "plt.yorentown.com"
    - "lawsonapi.yorentown.com"

  url-rewrite:
    - >-
      ^https:\/\/plt\.yorentown\.com\/pltapp\/v1\/banner - reject-dict

  script:
    - match: ^https:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v1\/
      name: "罗森点点_13"
      type: response
      require-body: true
      timeout: 60

    - match: ^https:\/\/lawsonapi\.yorentown\.com\/portal\/app\/globalLaunch\/listAdvert
      name: "罗森点点_13"
      type: response
      require-body: true
      timeout: 60

script-providers:
  "罗森点点_13":
    url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/lawson.js
    interval: 86400

