http:

  mitm:
    - "client.tujia.com"

  url-rewrite:
    - >-
      ^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/(promotion\/popup\/getpopupups\/bnb|portal\/getStartPictureAdvertising) - reject
    - >-
      ^https?:\/\/client\.tujia\.com\/bnbapp-node - reject-dict

  body-rewrite:
    - >-
      ^https?:\/\/client\.tujia\.com\/bnbapp-node\/app\/portal\/getportalconfig\/bnb\/v2 response-replace-regex "banners":\[.+\], "banners":[],

