http:

  mitm:
    - "api-cslp-emt.amazon.cn"

  url-rewrite:
    - >-
      ^https?:\/\/api-cslp-emt\.amazon\.cn\/gateway\/content\/widget\/popup - reject-200
    - >-
      ^https?:\/\/api-cslp-emt\.amazon\.cn\/gateway\/recommend - reject-dict

