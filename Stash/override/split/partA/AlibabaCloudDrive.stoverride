name: |-
  阿里云盘
desc: |-
  某些APP要清除缓存或者重新安装拦截广告才会生效！
author: |-
  奶思
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1061.png
category: |-
  奶思的模块
homepage: |-
  https://github.com/fmz200/wool_scripts
raw-url: |-
  https://github.com/fmz200/wool_scripts/raw/main/Surge/module/split/partA/AlibabaCloudDrive.sgmodule
tg-channel: |-
  https://t.me/inaisi
date: |-
  2026-11-11 21:17:23

http:

  mitm:
    - "api.alipan.com"
    - "member.alipan.com"

  url-rewrite:
    - >-
      ^https:\/\/api\.alipan\.com\/adrive\/v1\/file\/getTopFolders - reject-dict
    - >-
      ^https:\/\/member\.alipan\.com\/v2\/activity\/sign_in_luckyBottle - reject-dict

  script:
    - match: ^https:\/\/api\.alipan\.com\/apps\/v2\/users\/home\/(news|widgets)
      name: "阿里云盘_14"
      type: response
      require-body: true
      timeout: 60

    - match: ^https:\/\/member\.alipan\.com\/v1\/users\/onboard_list
      name: "阿里云盘_14"
      type: response
      require-body: true
      timeout: 60

script-providers:
  "阿里云盘_14":
    url: https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/adrive/adrive.js
    interval: 86400

